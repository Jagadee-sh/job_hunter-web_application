# OpenAI API Key (required for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (default: SQLite for development)
# For production, use PostgreSQL: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=sqlite+aiosqlite:///./jobhunter.db

# Redis URL (for Celery tasks)
REDIS_URL=redis://localhost:6379/0

# OpenAI Model
OPENAI_MODEL=gpt-4o-mini

# Job Board URLs (comma-separated)
JOB_BOARD_URLS=

# Log Level
LOG_LEVEL=INFO

# App Environment
APP_ENV=production
